<!-- Non-Blocking Toast Banner -->
<div id="toast" class="no-print fixed bottom-4 right-4 z-50 bg-[#0f1d36] text-white px-4 py-2.5 rounded-lg text-xs font-semibold shadow-xl opacity-0 translate-y-2 pointer-events-none transition-all duration-200"></div>

<script>
(function () {
  "use strict";

  const $ = id => document.getElementById(id);

  // Storage keys for sequential numbering, saved drafts, and active layout template
  const SEQ_KEY = "800batteryLastSeq";
  const DRAFT_KEY = "800batteryDraft";
  const TEMPLATE_KEY = "800batteryTemplate";
  const PREFIX = "800CB-";

  const ALL_TEMPLATES = [
    "tpl-executive",
    "tpl-mobile-quick",
    "tpl-minimal-gold",
    "tpl-split-ledger"
  ];

  const TEMPLATE_NAMES = {
    "tpl-executive": "Executive Navy Banner",
    "tpl-mobile-quick": "Mobile-First Quick-Service Card",
    "tpl-minimal-gold": "Minimalist Light & Gold",
    "tpl-split-ledger": "Split-Sidebar Ledger"
  };

  // Safe in-memory fallback when localStorage is restricted in a sandboxed iframe
  const memoryStore = new Map();
  function readStorage(key) {
    try {
      return window.localStorage.getItem(key);
    } catch {
      return memoryStore.has(key) ? memoryStore.get(key) : null;
    }
  }
  function writeStorage(key, value) {
    try {
      window.localStorage.setItem(key, String(value));
    } catch {
      memoryStore.set(key, String(value));
    }
  }

  let toastTimer = null;
  let pendingConfirmAction = null;
  let currentTemplate = "tpl-executive";

  /**
   * Displays a non-blocking toast notification at the bottom-right corner.
   */
  function notify(msg) {
    try {
      const el = $("toast");
      if (!el) return;
      el.textContent = msg;
      el.classList.remove("opacity-0", "translate-y-2");
      el.classList.add("opacity-100", "translate-y-0");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        el.classList.remove("opacity-100", "translate-y-0");
        el.classList.add("opacity-0", "translate-y-2");
      }, 2600);
    } catch (err) {
      console.error("Notification error:", err);
    }
  }

  /**
   * Opens an inline confirmation bar in the toolbar instead of window.confirm().
   */
  function openInlineConfirm(title, message, onConfirm) {
    const bar = $("inlineConfirmBar");
    if (!bar) {
      if (typeof onConfirm === "function") onConfirm();
      return;
    }
    $("inlineConfirmTitle").textContent = (title || "Confirm") + ":";
    $("inlineConfirmMessage").textContent = message || "Are you sure?";
    pendingConfirmAction = typeof onConfirm === "function" ? onConfirm : null;
    bar.classList.remove("hidden");
  }

  function closeInlineConfirm() {
    pendingConfirmAction = null;
    const bar = $("inlineConfirmBar");
    if (bar) bar.classList.add("hidden");
  }

  /**
   * Moves shared structural panels cleanly between standard flow and the Split-Sidebar Ledger.
   */
  function arrangePanelsForTemplate(tplClass) {
    const logoSvg = $("brandLogoSvg");
    const headerLogoTarget = $("headerLogoTarget");
    const splitLeftCol = $("splitLeftCol");
    const supplierPanel = $("supplierPanel");
    const supplierSlot = $("supplierSlot");
    const metaStrip = $("metaStrip");
    const metaSlot = $("metaSlot");
    const termsCard = $("termsCard");
    const termsSlot = $("termsSlot");

    if (!logoSvg || !headerLogoTarget || !splitLeftCol || !supplierPanel || !supplierSlot || !metaStrip || !metaSlot || !termsCard || !termsSlot) {
      return;
    }

    if (tplClass === "tpl-split-ledger") {
      // Left sidebar holds: Logo, Supplier Details + TRN, Invoice Metadata, Terms & Conditions
      if (logoSvg.parentElement !== splitLeftCol) {
        splitLeftCol.insertBefore(logoSvg, splitLeftCol.firstChild);
      }
      if (supplierPanel.parentElement !== splitLeftCol) {
        splitLeftCol.appendChild(supplierPanel);
      }
      if (metaStrip.parentElement !== splitLeftCol) {
        splitLeftCol.appendChild(metaStrip);
      }
      if (termsCard.parentElement !== splitLeftCol) {
        splitLeftCol.appendChild(termsCard);
      }
    } else {
      // Standard flow: Logo in header bar, Supplier in 2-col grid, Metadata strip below grid, Terms beside Totals
      if (logoSvg.parentElement !== headerLogoTarget) {
        headerLogoTarget.appendChild(logoSvg);
      }
      if (supplierPanel.parentElement !== supplierSlot) {
        supplierSlot.appendChild(supplierPanel);
      }
      if (metaStrip.parentElement !== metaSlot) {
        metaSlot.appendChild(metaStrip);
      }
      if (termsCard.parentElement !== termsSlot) {
        termsSlot.appendChild(termsCard);
      }
    }
  }

  /**
   * Switches the active layout template across all 4 presets and updates toolbar button states.
   */
  function applyTemplate(tplClass, showToast = false) {
    const sheet = $("invoice");
    if (!sheet) return;

    const validTpl = ALL_TEMPLATES.includes(tplClass) ? tplClass : "tpl-executive";
    currentTemplate = validTpl;

    ALL_TEMPLATES.forEach(cls => sheet.classList.remove(cls));
    sheet.classList.add(validTpl);

    arrangePanelsForTemplate(validTpl);
    writeStorage(TEMPLATE_KEY, validTpl);

    document.querySelectorAll(".tpl-btn").forEach(btn => {
      const isActive = btn.getAttribute("data-template") === validTpl;
      btn.className = isActive
        ? "tpl-btn px-3 py-1.5 rounded-lg text-xs font-bold border transition cursor-pointer bg-[#0f1d36] text-white border-[#0f1d36] shadow-xs"
        : "tpl-btn px-3 py-1.5 rounded-lg text-xs font-bold border transition cursor-pointer bg-slate-100 text-[#0f1d36] border-slate-200 hover:bg-slate-200";
    });

    if (showToast) {
      notify("Layout: " + (TEMPLATE_NAMES[validTpl] || validTpl));
    }
  }

  /**
   * Formats a numeric value in UAE Dirhams (AED) with two decimal places.
   */
  function money(n) {
    const num = Number(n);
    const safe = Number.isFinite(num) ? num : 0;
    return "AED " + safe.toLocaleString("en-AE", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });
  }

  /**
   * Formats a sequence number like 1 -> "800CB-0001".
   */
  function formatSeq(num) {
    const cleanNum = Math.max(1, parseInt(num, 10) || 1);
    return PREFIX + String(cleanNum).padStart(4, "0");
  }

  function getLastSeq() {
    return Math.max(0, parseInt(readStorage(SEQ_KEY) || "0", 10) || 0);
  }

  function updateNextSeqLabel() {
    const label = $("nextSeqLabel");
    if (label) {
      label.textContent = formatSeq(getLastSeq() + 1);
    }
  }

  function assignNextInvoiceNumber() {
    const next = getLastSeq() + 1;
    writeStorage(SEQ_KEY, String(next));
    const invInput = $("invoiceNo");
    if (invInput) {
      invInput.value = formatSeq(next);
    }
    updateNextSeqLabel();
  }

  function resetSequence() {
    openInlineConfirm(
      "Reset Sequence",
      "Reset automatic invoice sequence counter back to 800CB-0001?",
      () => {
        writeStorage(SEQ_KEY, "0");
        updateNextSeqLabel();
        notify("Sequence reset to 800CB-0001");
      }
    );
  }

  /**
   * Adds a new line item row to the invoice items table.
   * If the first row is completely empty, populates that row instead of leaving a blank row above it.
   */
  function addItem(desc = "", qty = 1, price = 0) {
    try {
      const tbody = $("items");
      if (!tbody) return;

      const existingRows = [...tbody.querySelectorAll("tr")];
      if (desc && existingRows.length === 1) {
        const onlyDesc = existingRows[0].querySelector(".desc");
        const onlyPrice = existingRows[0].querySelector(".price");
        const onlyQty = existingRows[0].querySelector(".qty");
        if (onlyDesc && !onlyDesc.value.trim() && (Number(onlyPrice && onlyPrice.value) || 0) === 0) {
          onlyDesc.value = desc;
          if (onlyQty) onlyQty.value = qty;
          if (onlyPrice) onlyPrice.value = price;
          calculate();
          return;
        }
      }

      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td><input class="desc" placeholder="Battery / service description"></td>
        <td><input class="qty qty-input" type="number" min="0" step="1" value="${qty}"></td>
        <td><input class="price price-input" type="number" min="0" step="0.01" value="${price}"></td>
        <td class="line-total">AED 0.00</td>
        <td class="remove-col"><button type="button" class="remove-item-btn" title="Remove item">×</button></td>
      `;

      const descInput = tr.querySelector(".desc");
      if (descInput) descInput.value = desc;

      tr.querySelectorAll("input").forEach(el => {
        el.addEventListener("input", calculate);
      });

      const removeBtn = tr.querySelector(".remove-item-btn");
      if (removeBtn) {
        removeBtn.addEventListener("click", () => {
          tr.remove();
          calculate();
          notify("Item removed");
        });
      }

      tbody.appendChild(tr);
      calculate();
    } catch (err) {
      console.error("Error adding item row:", err);
      notify("Could not add item row");
    }
  }

  /**
   * Recalculates line totals, discount, taxable amount, VAT, total due, balance due, and status pill.
   */
  function calculate() {
    try {
      let rawLinesTotal = 0;

      document.querySelectorAll("#items tr").forEach(tr => {
        const qtyEl = tr.querySelector(".qty");
        const priceEl = tr.querySelector(".price");
        const totalEl = tr.querySelector(".line-total");
        const qty = Math.max(0, Number(qtyEl && qtyEl.value) || 0);
        const price = Math.max(0, Number(priceEl && priceEl.value) || 0);
        const amount = qty * price;
        rawLinesTotal += amount;
        if (totalEl) totalEl.textContent = money(amount);
      });

      const modeEl = $("vatMode");
      const mode = modeEl ? modeEl.value : "exclusive";
      const discount = Math.max(0, Number($("discount") && $("discount").value) || 0);
      const rate = Math.max(0, Number($("vatRate") && $("vatRate").value) || 0);
      const paid = Math.max(0, Number($("paid") && $("paid").value) || 0);

      let taxable = 0;
      let vat = 0;
      let total = 0;

      if (mode === "inclusive") {
        const netAfterDiscount = Math.max(0, rawLinesTotal - discount);
        const divisor = 1 + (rate / 100);
        taxable = divisor > 0 ? netAfterDiscount / divisor : netAfterDiscount;
        vat = netAfterDiscount - taxable;
        total = netAfterDiscount;
        if ($("grossLabel")) $("grossLabel").textContent = "Items Total (VAT Inc.)";
        if ($("vatModeNote")) $("vatModeNote").textContent = "Prices already include VAT; discount is applied to gross total.";
      } else {
        taxable = Math.max(0, rawLinesTotal - discount);
        vat = taxable * (rate / 100);
        total = taxable + vat;
        if ($("grossLabel")) $("grossLabel").textContent = "Items Total (VAT Exc.)";
        if ($("vatModeNote")) $("vatModeNote").textContent = "Prices are VAT-exclusive; VAT is calculated on taxable amount after discount.";
      }

      const balanceDue = Math.max(0, total - paid);

      if ($("subtotal")) $("subtotal").textContent = money(rawLinesTotal);
      if ($("taxable")) $("taxable").textContent = money(taxable);
      if ($("vat")) $("vat").textContent = money(vat);
      if ($("grand")) $("grand").textContent = money(total);
      if ($("balance")) $("balance").textContent = money(balanceDue);

      // Update status badge shown in Mobile-First Quick-Service layout
      const pill = $("paymentStatusPill");
      if (pill) {
        if (total > 0 && balanceDue <= 0.005) {
          pill.textContent = "Paid in Full";
          pill.className = "status-pill bg-emerald-100 text-emerald-900 border border-emerald-300";
        } else if (paid > 0 && balanceDue > 0) {
          pill.textContent = "Partial • Due " + money(balanceDue);
          pill.className = "status-pill bg-sky-100 text-sky-900 border border-sky-300";
        } else {
          pill.textContent = "Due " + money(balanceDue);
          pill.className = "status-pill bg-amber-100 text-amber-900 border border-amber-300";
        }
      }
    } catch (err) {
      console.error("Calculation error:", err);
    }
  }

  function performNewInvoice() {
    document.querySelectorAll(
      "#customer,#phone,#email,#vehicle,#plate,#battery"
    ).forEach(el => {
      el.value = "";
    });

    if ($("discount")) $("discount").value = 0;
    if ($("vatRate")) $("vatRate").value = 5;
    if ($("paid")) $("paid").value = 0;
    if ($("payment")) $("payment").selectedIndex = 0;
    if ($("vatMode")) $("vatMode").value = "exclusive";
    assignNextInvoiceNumber();
    if ($("invoiceDate")) $("invoiceDate").value = new Date().toISOString().slice(0, 10);

    if ($("items")) $("items").innerHTML = "";
    addItem();
    notify("New invoice created");
  }

  function newInvoice() {
    openInlineConfirm(
      "New Invoice",
      "Clear current invoice and assign the next sequential invoice number?",
      performNewInvoice
    );
  }

  function printInvoice() {
    try {
      notify("Opening print / PDF dialog...");
      window.print();
    } catch (err) {
      console.error("Print error:", err);
      notify("Unable to open print dialog");
    }
  }

  function saveDraft() {
    try {
      const fields = [
        "customer", "phone", "email", "vehicle", "plate", "battery",
        "invoiceNo", "invoiceDate", "payment", "vatMode",
        "discount", "vatRate", "paid"
      ];

      const data = {
        template: currentTemplate
      };
      fields.forEach(id => {
        const el = $(id);
        if (el) data[id] = el.value;
      });

      data.items = [...document.querySelectorAll("#items tr")].map(tr => [
        tr.querySelector(".desc") ? tr.querySelector(".desc").value : "",
        tr.querySelector(".qty") ? tr.querySelector(".qty").value : "1",
        tr.querySelector(".price") ? tr.querySelector(".price").value : "0"
      ]);

      writeStorage(DRAFT_KEY, JSON.stringify(data));
      notify("Draft saved");
    } catch (err) {
      console.error("Failed to save draft:", err);
      notify("Could not save draft");
    }
  }

  function loadDraft() {
    try {
      const raw = readStorage(DRAFT_KEY);
      const data = raw ? JSON.parse(raw) : null;
      if (!data) {
        notify("No saved draft found");
        return;
      }

      if (data.template && ALL_TEMPLATES.includes(data.template)) {
        applyTemplate(data.template, false);
      }

      Object.keys(data).forEach(key => {
        if (key === "items" || key === "template") return;
        const el = $(key);
        if (el && typeof data[key] === "string") {
          el.value = data[key];
        }
      });

      const tbody = $("items");
      if (tbody) tbody.innerHTML = "";
      (data.items || []).forEach(item => addItem(item[0], item[1], item[2]));
      if (!data.items || !data.items.length) {
        addItem();
      }

      calculate();
      notify("Draft loaded");
    } catch (err) {
      console.error("Failed to load draft:", err);
      notify("Could not load saved draft");
    }
  }

  function normalizePhoneForWhatsApp(raw) {
    let digits = (raw || "").replace(/[^\d]/g, "");
    if (!digits) return "";
    if (digits.startsWith("00")) {
      digits = digits.slice(2);
    }
    if (digits.startsWith("05") && digits.length === 10) {
      digits = "971" + digits.slice(1);
    }
    return digits;
  }

  function copyTextSafe(text) {
    const temp = document.createElement("textarea");
    temp.value = text;
    temp.style.position = "fixed";
    temp.style.opacity = "0";
    document.body.appendChild(temp);
    temp.select();
    let ok = false;
    try {
      ok = document.execCommand("copy");
    } catch {
      ok = false;
    }
    temp.remove();
    return ok;
  }

  function shareWhatsApp() {
    try {
      const invNo = ($("invoiceNo") && $("invoiceNo").value.trim()) || "Draft";
      const date = ($("invoiceDate") && $("invoiceDate").value) || new Date().toISOString().slice(0, 10);
      const customer = ($("customer") && $("customer").value.trim()) || "Valued Customer";
      const vehicle = $("vehicle") ? $("vehicle").value.trim() : "";
      const plate = $("plate") ? $("plate").value.trim() : "";
      const battery = $("battery") ? $("battery").value.trim() : "";

      const lines = [...document.querySelectorAll("#items tr")]
        .map(tr => {
          const desc = tr.querySelector(".desc") ? tr.querySelector(".desc").value.trim() : "";
          const qty = Number(tr.querySelector(".qty") && tr.querySelector(".qty").value) || 0;
          const price = Number(tr.querySelector(".price") && tr.querySelector(".price").value) || 0;
          if (!desc && price === 0) return null;
          return `• ${desc || "Item"} (${qty} × ${money(price)}) = ${money(qty * price)}`;
        })
        .filter(Boolean);

      const grandText = $("grand") ? $("grand").textContent : "AED 0.00";
      const paidVal = $("paid") ? $("paid").value : 0;
      const balanceText = $("balance") ? $("balance").textContent : "AED 0.00";

      const msg = [
        "*800 Battery Experts — Tax Invoice*",
        "TRN: 100482917360503",
        `Invoice #: *${invNo}* | Date: ${date}`,
        `Customer: ${customer}`,
        vehicle ? `Vehicle: ${vehicle}${plate ? ` (${plate})` : ""}` : (plate ? `Plate: ${plate}` : ""),
        battery ? `Battery: ${battery}` : "",
        lines.length ? `\n*Items:*\n${lines.join("\n")}` : "",
        `\n*Total Due:* ${grandText}`,
        `Paid: ${money(paidVal)}`,
        `*Balance Due:* ${balanceText}`,
        "\nThank you for choosing 800 Battery Experts."
      ].filter(Boolean).join("\n");

      const phone = normalizePhoneForWhatsApp($("phone") ? $("phone").value : "");
      const url = phone
        ? `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`
        : `https://wa.me/?text=${encodeURIComponent(msg)}`;

      const shareBar = $("whatsappShareBar");
      if (shareBar) {
        $("waPreviewText").value = msg;
        $("waDirectAnchor").href = url;
        shareBar.classList.remove("hidden");
      }

      const win = window.open(url, "_blank", "noopener,noreferrer");
      if (win) {
        notify("Opening WhatsApp share...");
      } else {
        notify("Popup blocked — use Open WhatsApp or Copy Summary above");
      }
    } catch (err) {
      console.error("WhatsApp share error:", err);
      notify("Unable to prepare WhatsApp summary");
    }
  }

  function saveImage() {
    try {
      const invoice = $("invoice");
      if (!invoice) return;

      notify("Generating invoice image...");
      const clone = invoice.cloneNode(true);

      clone.className = "invoice-sheet tpl-executive";
      clone.style.display = "block";
      clone.style.width = "794px";
      clone.style.minHeight = "1123px";
      clone.style.padding = "28px";
      clone.style.margin = "0";
      clone.style.boxShadow = "none";
      clone.style.borderRadius = "0";
      clone.style.border = "0";
      clone.style.background = "#ffffff";

      // Ensure standard order inside exported image clone
      const splitLeft = clone.querySelector("#splitLeftCol");
      const splitRight = clone.querySelector("#splitRightCol");
      const logoSvg = clone.querySelector("#brandLogoSvg");
      const headerLogoTarget = clone.querySelector("#headerLogoTarget");
      const supplierPanel = clone.querySelector("#supplierPanel");
      const supplierSlot = clone.querySelector("#supplierSlot");
      const metaStrip = clone.querySelector("#metaStrip");
      const metaSlot = clone.querySelector("#metaSlot");
      const termsCard = clone.querySelector("#termsCard");
      const termsSlot = clone.querySelector("#termsSlot");
      const invoiceFooter = clone.querySelector(".invoice-footer");

      if (logoSvg && headerLogoTarget) headerLogoTarget.appendChild(logoSvg);
      if (supplierPanel && supplierSlot) supplierSlot.appendChild(supplierPanel);
      if (metaStrip && metaSlot) metaSlot.appendChild(metaStrip);
      if (termsCard && termsSlot) termsSlot.appendChild(termsCard);
      if (splitLeft && splitRight) {
        while (splitLeft.firstChild) splitLeft.removeChild(splitLeft.firstChild);
        if (splitRight.firstChild) {
          [...splitRight.firstChild.children].forEach(child => clone.appendChild(child));
        }
        if (invoiceFooter) clone.appendChild(invoiceFooter);
        splitLeft.remove();
        splitRight.remove();
      }

      clone.querySelectorAll("input, textarea, select").forEach(el => {
        const isInSummaryRow = !!el.closest(".summary-row");
        const replacement = document.createElement("span");
        replacement.textContent = el.value || "";
        replacement.style.display = isInSummaryRow ? "inline-block" : "block";
        replacement.style.padding = "3px 4px";
        replacement.style.minHeight = "16px";
        replacement.style.fontWeight = isInSummaryRow ? "700" : "400";
        replacement.style.whiteSpace = "pre-wrap";
        el.replaceWith(replacement);
      });

      clone.querySelectorAll(".remove-col, .no-print, .preset-bar").forEach(el => el.remove());

      const svgNS = "http://www.w3.org/2000/svg";
      const svg = document.createElementNS(svgNS, "svg");
      svg.setAttribute("xmlns", svgNS);
      svg.setAttribute("width", "794");
      svg.setAttribute("height", "1123");

      const foreign = document.createElementNS(svgNS, "foreignObject");
      foreign.setAttribute("width", "794");
      foreign.setAttribute("height", "1123");

      const div = document.createElement("div");
      div.setAttribute("xmlns", "http://www.w3.org/1999/xhtml");

      const style = document.createElement("style");
      const pageStyles = [...document.querySelectorAll("style")].map(s => s.textContent).join("\n");
      style.textContent = pageStyles +
        "body{background:#fff;font-family:Inter,Arial,sans-serif}.invoice-sheet{box-shadow:none;border:0}";
      div.appendChild(style);
      div.appendChild(clone);

      foreign.appendChild(div);
      svg.appendChild(foreign);

      const svgData = new XMLSerializer().serializeToString(svg);
      const blob = new Blob([svgData], { type: "image/svg+xml;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const img = new Image();

      img.onload = () => {
        const canvas = document.createElement("canvas");
        canvas.width = 1588;
        canvas.height = 2246;

        const ctx = canvas.getContext("2d");
        ctx.fillStyle = "#ffffff";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

        canvas.toBlob(result => {
          URL.revokeObjectURL(url);
          if (!result) {
            notify("Image export failed — try Print / Save PDF");
            return;
          }
          const a = document.createElement("a");
          a.href = URL.createObjectURL(result);
          const invNum = ($("invoiceNo") && $("invoiceNo").value.trim()) || "800-Battery-Invoice";
          a.download = invNum + ".png";
          document.body.appendChild(a);
          a.click();
          a.remove();
          notify("Invoice PNG downloaded");
        }, "image/png");
      };

      img.onerror = () => {
        URL.revokeObjectURL(url);
        notify("Image export blocked by browser — use Print / Save PDF");
      };

      img.src = url;
    } catch (err) {
      console.error("Image export error:", err);
      notify("Image export failed — try Print / Save PDF");
    }
  }

  function bindAllControls() {
    // Template switcher buttons
    document.querySelectorAll(".tpl-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const tpl = btn.getAttribute("data-template");
        applyTemplate(tpl, true);
      });
    });

    // Quick-service preset chips in Mobile-First layout
    document.querySelectorAll(".preset-chip").forEach(chip => {
      chip.addEventListener("click", () => {
        const desc = chip.getAttribute("data-preset-desc") || "Service";
        const price = Number(chip.getAttribute("data-preset-price")) || 0;
        addItem(desc, 1, price);
        notify("Added: " + desc);
      });
    });

    if ($("inlineConfirmCancelBtn")) {
      $("inlineConfirmCancelBtn").addEventListener("click", closeInlineConfirm);
    }
    if ($("inlineConfirmProceedBtn")) {
      $("inlineConfirmProceedBtn").addEventListener("click", () => {
        const action = pendingConfirmAction;
        closeInlineConfirm();
        if (typeof action === "function") {
          action();
        }
      });
    }

    if ($("btnCopyWaMsg")) {
      $("btnCopyWaMsg").addEventListener("click", () => {
        const text = $("waPreviewText") ? $("waPreviewText").value : "";
        if (copyTextSafe(text)) {
          notify("WhatsApp summary copied to clipboard");
        } else {
          notify("Select and copy the text above");
        }
      });
    }
    if ($("btnCloseWaBar")) {
      $("btnCloseWaBar").addEventListener("click", () => {
        if ($("whatsappShareBar")) $("whatsappShareBar").classList.add("hidden");
      });
    }

    // Delegated click listener for toolbar & action buttons
    document.addEventListener("click", event => {
      const btn = event.target.closest("[data-action]");
      if (!btn) return;
      const action = btn.getAttribute("data-action");
      switch (action) {
        case "addItem":
          addItem();
          notify("Item added");
          break;
        case "shareWhatsApp":
          shareWhatsApp();
          break;
        case "printInvoice":
          printInvoice();
          break;
        case "saveImage":
          saveImage();
          break;
        case "saveDraft":
          saveDraft();
          break;
        case "loadDraft":
          loadDraft();
          break;
        case "newInvoice":
          newInvoice();
          break;
        case "resetSequence":
          resetSequence();
          break;
        default:
          break;
      }
    });

    if ($("vatMode")) {
      $("vatMode").addEventListener("change", calculate);
    }
    ["discount", "vatRate", "paid"].forEach(id => {
      const el = $(id);
      if (el) el.addEventListener("input", calculate);
    });
  }

  function initApp() {
    bindAllControls();
    const savedTpl = readStorage(TEMPLATE_KEY);
    applyTemplate(savedTpl || "tpl-executive", false);
    assignNextInvoiceNumber();
    if ($("invoiceDate") && !$("invoiceDate").value) {
      $("invoiceDate").value = new Date().toISOString().slice(0, 10);
    }
    if ($("items") && $("items").children.length === 0) {
      addItem();
    }
    calculate();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initApp);
  } else {
    initApp();
  }
})();
</script>

