<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>800 Battery Experts - Tax Invoice &amp; Layout Previewer</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
  :root {
    --navy: #0f1d36;
    --navy-2: #1b3158;
    --gold: #b8944b;
    --orange: #f28c28;
    --line: #dce2ea;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #eef2f6;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
    color: #162032;
    font-size: 13px;
  }

  /* Base A4 Sheet Container */
  .invoice-sheet {
    width: 210mm;
    min-height: 297mm;
    margin: 18px auto 28px;
    padding: 11mm;
    background: #ffffff;
    box-shadow: 0 10px 32px rgba(15, 29, 54, 0.08);
    border-radius: 10px;
    border: 1px solid #e2e8f0;
    transition: all 0.2s ease;
  }

  /* Default shared elements */
  .brand-svg {
    width: 225px;
    height: auto;
    display: block;
    flex-shrink: 0;
  }

  .header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 3px solid var(--orange);
    padding-bottom: 12px;
    gap: 16px;
  }

  .invoice-title-box {
    text-align: right;
  }

  .invoice-title-box h1 {
    color: var(--navy);
    font-size: 25px;
    font-weight: 800;
    letter-spacing: 0.6px;
    margin: 0;
  }

  .company-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 12px;
    margin: 14px 0;
  }

  .panel-box {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 11px;
    background: #ffffff;
  }

  .panel-heading {
    font-size: 11px;
    font-weight: 700;
    color: var(--navy-2);
    margin: 0 0 8px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    border-bottom: 1px solid #eef2f6;
    padding-bottom: 5px;
  }

  .customer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 7px 10px;
  }

  .field-group {
    margin-bottom: 3px;
  }

  .field-group.full-span {
    grid-column: 1 / -1;
  }

  .field-label {
    display: block;
    color: #5b667a;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.35px;
    margin-bottom: 3px;
    text-transform: uppercase;
  }

  .inv-input {
    width: 100%;
    padding: 6px 8px;
    border: 1px solid var(--line);
    border-radius: 6px;
    font-family: inherit;
    font-size: 12px;
    color: #162032;
    background: #ffffff;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .inv-input:focus {
    outline: none;
    border-color: var(--navy-2);
    box-shadow: 0 0 0 2px rgba(27, 49, 88, 0.08);
  }

  .trn-box {
    margin-top: 8px;
    padding: 6px 8px;
    background: #f8fafc;
    border-left: 3px solid var(--gold);
    border-radius: 6px;
    font-size: 11px;
  }

  .meta-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin: 12px 0;
    padding: 10px;
    background: #f8fafc;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .section-heading {
    color: var(--navy);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin: 14px 0 7px;
    text-transform: uppercase;
  }

  .preset-bar {
    display: none;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 8px;
  }

  .preset-chip {
    padding: 6px 10px;
    border-radius: 999px;
    background: #fff7ed;
    border: 1px solid #fdba74;
    color: #9a3412;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .preset-chip:hover {
    background: #ffedd5;
  }

  .items-table {
    width: 100%;
    border-collapse: collapse;
  }

  .items-table th {
    background: var(--navy);
    color: #ffffff;
    padding: 8px 7px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.4px;
    text-align: left;
  }

  .items-table th:first-child {
    border-top-left-radius: 6px;
  }

  .items-table th:last-child {
    border-top-right-radius: 6px;
  }

  .items-table td {
    border-bottom: 1px solid var(--line);
    padding: 5px 6px;
  }

  .items-table td input {
    border: 1px solid transparent;
    background: #f8fafc;
    padding: 6px;
    border-radius: 6px;
    width: 100%;
    font-family: inherit;
    font-size: 12px;
    color: #162032;
  }

  .items-table td input:focus {
    outline: none;
    background: #ffffff;
    border-color: var(--navy-2);
  }

  .qty-input {
    width: 68px !important;
  }

  .price-input {
    width: 108px !important;
  }

  .line-total {
    text-align: right;
    white-space: nowrap;
    font-weight: 700;
    color: var(--navy);
  }

  .remove-item-btn {
    padding: 4px 9px;
    background: #fee2e2;
    color: #991b1b;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
    border: 0;
    cursor: pointer;
  }

  .remove-item-btn:hover {
    background: #fecaca;
  }

  .bottom-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.95fr;
    gap: 12px;
    margin-top: 14px;
    align-items: stretch;
  }

  .totals-card {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 11px;
    background: #f8fafc;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 0;
    border-bottom: 1px solid #e2e8f0;
    font-size: 11.5px;
    gap: 10px;
  }

  .summary-row:last-child {
    border-bottom: 0;
  }

  .summary-row input {
    max-width: 108px;
    text-align: right;
    background: #ffffff;
  }

  .grand-total-row {
    color: var(--navy);
    font-size: 16px;
    font-weight: 800;
    background: #ffffff;
    margin: 4px -4px;
    padding: 8px 8px;
    border-radius: 6px;
    border: 1px solid #cbd5e1;
  }

  .terms-card {
    border: 1px solid var(--line);
    border-left: 4px solid var(--gold);
    border-radius: 8px;
    padding: 12px 14px;
    background: #fcfcfd;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .terms-card h3 {
    margin: 0 0 8px;
    font-size: 11px;
    font-weight: 700;
    color: var(--navy);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    border-bottom: 1px solid #eef2f6;
    padding-bottom: 5px;
  }

  .terms-card p {
    font-size: 10px;
    color: #334155;
    line-height: 1.5;
    margin: 3.5px 0;
  }

  .invoice-footer {
    text-align: center;
    color: #64748b;
    border-top: 1px solid var(--line);
    margin-top: 12px;
    padding-top: 9px;
    font-size: 10.5px;
  }

  .status-pill {
    display: none;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }

  /* =========================================================================
     TEMPLATE 1: EXECUTIVE NAVY BANNER (Corporate & Fleet-Ready)
     ========================================================================= */
  .invoice-sheet.tpl-executive {
    border-top: 6px solid var(--gold);
  }

  .invoice-sheet.tpl-executive .header-bar {
    background: linear-gradient(135deg, #0f1d36 0%, #1a3056 100%);
    color: #ffffff;
    padding: 16px 18px;
    border-radius: 8px;
    border-bottom: 4px solid var(--gold);
  }

  .invoice-sheet.tpl-executive .header-bar svg .logo-navy-text {
    fill: #ffffff;
  }

  .invoice-sheet.tpl-executive .header-bar svg .logo-tagline-navy {
    fill: #e2e8f0;
  }

  .invoice-sheet.tpl-executive .invoice-title-box h1 {
    color: #f3dca2;
    font-size: 26px;
    letter-spacing: 1px;
  }

  .invoice-sheet.tpl-executive .invoice-title-box p {
    color: #cbd5e1;
  }

  .invoice-sheet.tpl-executive .panel-heading {
    color: #9a752c;
    border-bottom-color: #f1e6ce;
  }

  .invoice-sheet.tpl-executive .meta-strip {
    background: #f8fafc;
    border-color: #cbd5e1;
    border-top: 3px solid var(--navy);
  }

  .invoice-sheet.tpl-executive .items-table th {
    background: #0f1d36;
    color: #f3dca2;
  }

  /* =========================================================================
     TEMPLATE 2: MOBILE-FIRST QUICK-SERVICE CARD (Roadside & Technician Speed)
     ========================================================================= */
  .invoice-sheet.tpl-mobile-quick {
    max-width: 680px;
    width: 100%;
    padding: 16px;
    background: #f8fafc;
    border: 2px solid #cbd5e1;
  }

  .invoice-sheet.tpl-mobile-quick .status-pill {
    display: inline-flex;
    align-items: center;
    margin-top: 6px;
  }

  .invoice-sheet.tpl-mobile-quick .preset-bar {
    display: flex;
  }

  .invoice-sheet.tpl-mobile-quick .company-grid,
  .invoice-sheet.tpl-mobile-quick .customer-grid,
  .invoice-sheet.tpl-mobile-quick .meta-strip,
  .invoice-sheet.tpl-mobile-quick .bottom-grid {
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .invoice-sheet.tpl-mobile-quick .panel-box,
  .invoice-sheet.tpl-mobile-quick .totals-card,
  .invoice-sheet.tpl-mobile-quick .terms-card {
    background: #ffffff;
    box-shadow: 0 2px 8px rgba(15, 29, 54, 0.04);
  }

  .invoice-sheet.tpl-mobile-quick .inv-input,
  .invoice-sheet.tpl-mobile-quick .items-table td input {
    padding: 9px 10px;
    font-size: 13px;
  }

  /* =========================================================================
     TEMPLATE 3: MINIMALIST LIGHT & GOLD (High-Whitespace Editorial)
     ========================================================================= */
  .invoice-sheet.tpl-minimal-gold {
    background: #ffffff;
    border: 1px solid #e5dec9;
    box-shadow: 0 8px 28px rgba(15, 29, 54, 0.05);
  }

  .invoice-sheet.tpl-minimal-gold .header-bar {
    border-bottom: 1px solid #d8c394;
    padding-bottom: 14px;
  }

  .invoice-sheet.tpl-minimal-gold .invoice-title-box h1 {
    color: #9a752c;
    font-weight: 700;
    letter-spacing: 1.5px;
  }

  .invoice-sheet.tpl-minimal-gold .panel-box,
  .invoice-sheet.tpl-minimal-gold .meta-strip,
  .invoice-sheet.tpl-minimal-gold .totals-card {
    background: #ffffff;
    border: 0;
    border-top: 1px solid #e6dec8;
    border-bottom: 1px solid #e6dec8;
    border-radius: 0;
    padding-left: 2px;
    padding-right: 2px;
  }

  .invoice-sheet.tpl-minimal-gold .panel-heading,
  .invoice-sheet.tpl-minimal-gold .section-heading,
  .invoice-sheet.tpl-minimal-gold .field-label {
    color: #9a752c;
  }

  .invoice-sheet.tpl-minimal-gold .items-table th {
    background: #faf6ec;
    color: #8b6925;
    border-top: 1px solid #d8c394;
    border-bottom: 1.5px solid #b8944b;
  }

  .invoice-sheet.tpl-minimal-gold .items-table tbody tr:nth-child(even) td {
    background: #fcfaf4;
  }

  .invoice-sheet.tpl-minimal-gold .items-table td input {
    background: transparent;
  }

  .invoice-sheet.tpl-minimal-gold .grand-total-row {
    background: #faf6ec;
    border-color: #d8c394;
    color: #0f1d36;
  }

  /* =========================================================================
     TEMPLATE 4: SPLIT-SIDEBAR LEDGER (Asymmetric 30% / 70% Split)
     ========================================================================= */
  .invoice-sheet.tpl-split-ledger {
    width: 220mm;
    padding: 0;
    overflow: hidden;
    display: grid;
    grid-template-columns: 30% 70%;
  }

  .invoice-sheet.tpl-split-ledger .split-left {
    background: #f1f5f9;
    border-right: 2px solid #cbd5e1;
    padding: 14px 12px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
  }

  .invoice-sheet.tpl-split-ledger .split-right {
    padding: 14px 16px;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .invoice-sheet.tpl-split-ledger .brand-svg {
    width: 100%;
    max-width: 195px;
    margin: 0 auto;
  }

  .invoice-sheet.tpl-split-ledger .header-bar {
    border-bottom: 2px solid var(--navy);
    padding-bottom: 10px;
    margin-bottom: 10px;
  }

  .invoice-sheet.tpl-split-ledger .company-grid {
    grid-template-columns: 1fr;
    margin: 8px 0;
  }

  .invoice-sheet.tpl-split-ledger .meta-strip {
    grid-template-columns: 1fr;
    background: #ffffff;
    margin: 6px 0;
    padding: 8px;
  }

  .invoice-sheet.tpl-split-ledger .bottom-grid {
    grid-template-columns: 1fr;
    margin-top: 12px;
  }

  .invoice-sheet.tpl-split-ledger .panel-box {
    background: #ffffff;
  }

  /* Responsive Layout Adjustments */
  @media (max-width: 900px) {
    .invoice-sheet,
    .invoice-sheet.tpl-split-ledger {
      width: 100%;
      min-height: 0;
      margin: 0;
      padding: 14px;
      border-radius: 0;
      border-left: 0;
      border-right: 0;
      display: block;
    }
    .invoice-sheet.tpl-split-ledger .split-left {
      border-right: 0;
      border-bottom: 2px solid #cbd5e1;
      border-radius: 8px;
      margin-bottom: 12px;
    }
    .invoice-sheet.tpl-split-ledger .split-right {
      padding: 0;
    }
    .meta-strip {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .header-bar {
      flex-direction: column;
      align-items: flex-start;
    }
    .invoice-title-box {
      text-align: left;
    }
    .brand-svg {
      width: 190px;
    }
    .company-grid,
    .customer-grid,
    .meta-strip,
    .bottom-grid {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .inv-input {
      min-width: 0;
    }
  }

  /* Print / Save PDF Styling */
  @media print {
    @page {
      size: A4 portrait;
      margin: 5mm;
    }

    body {
      background: #ffffff;
      font-size: 9px;
    }

    .no-print,
    .remove-col,
    .preset-bar {
      display: none !important;
    }

    .invoice-sheet,
    .invoice-sheet.tpl-split-ledger,
    .invoice-sheet.tpl-mobile-quick {
      width: 100% !important;
      max-width: 100% !important;
      min-height: 0;
      margin: 0 !important;
      padding: 3mm !important;
      box-shadow: none !important;
      border: 0 !important;
      border-radius: 0 !important;
      background: #ffffff !important;
    }

    .invoice-sheet.tpl-split-ledger {
      display: grid !important;
      grid-template-columns: 31% 69% !important;
      gap: 8px;
    }

    .invoice-sheet.tpl-split-ledger .split-left {
      background: #f8fafc !important;
      border-right: 1px solid #cbd5e1 !important;
      border-bottom: 0 !important;
      padding: 6px !important;
    }

    .invoice-sheet.tpl-split-ledger .split-right {
      padding: 6px !important;
    }

    .brand-svg {
      width: 165px;
    }

    .invoice-title-box h1 {
      font-size: 18px;
    }

    .company-grid,
    .meta-strip,
    .bottom-grid {
      margin: 6px 0;
      gap: 7px;
    }

    .panel-box,
    .totals-card,
    .meta-strip {
      padding: 6px;
      background: #ffffff;
    }

    .items-table th {
      padding: 5px;
    }

    .items-table td {
      padding: 3px;
    }

    .inv-input,
    .items-table td input {
      border: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
      padding: 2px !important;
      font-size: 9px;
      color: #111111;
      appearance: none;
      -webkit-appearance: none;
    }

    .summary-row {
      padding: 3px 0;
    }

    .grand-total-row {
      font-size: 12px;
      padding: 4px;
    }

    .terms-card {
      padding: 7px 9px;
    }

    .terms-card p {
      font-size: 7.8px;
      line-height: 1.3;
      margin: 2px 0;
    }

    .terms-card h3 {
      font-size: 8.5px;
      margin-bottom: 4px;
    }

    .invoice-footer {
      margin-top: 6px;
      padding-top: 4px;
    }

    tr,
    .panel-box,
    .totals-card,
    .terms-card {
      break-inside: avoid;
    }
  }
</style>
</head>

<body>

<!-- Sticky App Action Toolbar & Live Layout Switcher -->
<div class="no-print sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-slate-200 px-3 py-2.5 shadow-sm">
  <div class="max-w-7xl mx-auto flex flex-col gap-2">

    <!-- Row 1: Layout Template Switcher -->
    <div class="flex flex-wrap items-center justify-center gap-1.5 pb-1.5 border-b border-slate-100">
      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mr-1">Layout Template:</span>
      <button type="button" data-template="tpl-executive" class="tpl-btn px-3 py-1.5 rounded-lg text-xs font-bold border transition cursor-pointer bg-[#0f1d36] text-white border-[#0f1d36]">
        1. Executive Navy Banner
      </button>
      <button type="button" data-template="tpl-mobile-quick" class="tpl-btn px-3 py-1.5 rounded-lg text-xs font-bold border transition cursor-pointer bg-slate-100 text-[#0f1d36] border-slate-200 hover:bg-slate-200">
        2. Mobile-First Quick-Service
      </button>
      <button type="button" data-template="tpl-minimal-gold" class="tpl-btn px-3 py-1.5 rounded-lg text-xs font-bold border transition cursor-pointer bg-slate-100 text-[#0f1d36] border-slate-200 hover:bg-slate-200">
        3. Minimalist Light &amp; Gold
      </button>
      <button type="button" data-template="tpl-split-ledger" class="tpl-btn px-3 py-1.5 rounded-lg text-xs font-bold border transition cursor-pointer bg-slate-100 text-[#0f1d36] border-slate-200 hover:bg-slate-200">
        4. Split-Sidebar Ledger
      </button>
    </div>

    <!-- Row 2: Primary Invoice Actions & Sequential Counter -->
    <div id="toolbarActions" class="flex flex-wrap items-center justify-center gap-2">
      <button type="button" id="btnAddItem" data-action="addItem" class="p-2 sm:px-3.5 sm:py-2 rounded-lg bg-[#f28c28] hover:bg-[#e07d1b] text-slate-950 font-bold text-xs transition cursor-pointer shadow-sm">
        + ADD ITEM
      </button>
      <button type="button" id="btnShareWhatsApp" data-action="shareWhatsApp" class="p-2 sm:px-3.5 sm:py-2 rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs transition cursor-pointer shadow-sm">
        SHARE WHATSAPP
      </button>
      <button type="button" id="btnPrintPdf" data-action="printInvoice" class="p-2 sm:px-3.5 sm:py-2 rounded-lg bg-[#0f1d36] hover:bg-[#1b3158] text-white font-bold text-xs transition cursor-pointer shadow-sm">
        PRINT / SAVE PDF
      </button>
      <button type="button" id="btnSaveImage" data-action="saveImage" class="p-2 sm:px-3.5 sm:py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-[#0f1d36] font-bold text-xs border border-slate-200 transition cursor-pointer">
        SAVE AS IMAGE
      </button>
      <button type="button" id="btnSaveDraft" data-action="saveDraft" class="p-2 sm:px-3.5 sm:py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-[#0f1d36] font-bold text-xs border border-slate-200 transition cursor-pointer">
        SAVE DRAFT
      </button>
      <button type="button" id="btnLoadDraft" data-action="loadDraft" class="p-2 sm:px-3.5 sm:py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-[#0f1d36] font-bold text-xs border border-slate-200 transition cursor-pointer">
        LOAD DRAFT
      </button>
      <button type="button" id="btnNewInvoice" data-action="newInvoice" class="p-2 sm:px-3.5 sm:py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-[#0f1d36] font-bold text-xs border border-slate-200 transition cursor-pointer">
        NEW INVOICE
      </button>

      <!-- Sequential Invoice Number Counter Pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-[11px] font-semibold text-[#0f1d36]">
        <span>Next Seq: <strong id="nextSeqLabel">800CB-0001</strong></span>
        <button type="button" id="btnResetSeq" data-action="resetSequence" title="Reset sequence counter" class="px-2 py-0.5 rounded-full bg-white hover:bg-rose-50 text-rose-700 border border-slate-300 text-[10px] font-bold cursor-pointer transition">
          Reset
        </button>
      </div>
    </div>
  </div>

  <!-- Iframe-Safe Inline Confirmation Prompt Bar -->
  <div id="inlineConfirmBar" class="hidden max-w-3xl mx-auto mt-2.5 p-3 rounded-xl bg-amber-50 border border-amber-300 flex flex-wrap items-center justify-between gap-3 shadow-xs">
    <div class="flex items-center gap-2 text-xs text-slate-800">
